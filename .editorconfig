root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[makefile]
indent_style = tab
indent_size = 4

[*.{html,css,js,jsx,ts,tsx}]
max_line_length = 80
indent_style = space
indent_size = 2

[*.rs]
max_line_length = 100
indent_style = space
indent_size = 4

[*.sql]
indent_style = tab
indent_size = 4
