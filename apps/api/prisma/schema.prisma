generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id           String @id @default(uuid()) @db.Uuid
  name         String @db.VarChar(255)
  avatarUrl    String @map("avatar_url") @db.VarChar(255)
  email        String @unique @db.VarChar(100)
  phone        String @unique @db.VarChar(20)
  passwordHash String @map("password_hash") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  @@map("staffs")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  roleCode    String  @unique @map("role_code") @db.VarChar(100)
  roleName    String  @map("role_name") @db.VarChar(255)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  staffs    Staff[]

  @@map("roles")
}

model Department {
  id             String  @id @default(uuid()) @db.Uuid
  departmentName String  @map("department_name") @db.VarChar(255)
  departmentCode String  @unique @map("department_code") @db.VarChar(100)
  description    String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  staffs    Staff[]

  @@map("departments")
}
