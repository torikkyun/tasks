generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  avatarUrl    String    @map("avatar_url") @db.VarChar(255)
  email        String    @unique @db.VarChar(100)
  phone        String    @unique @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction)
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: NoAction)

  projectMemberships ProjectMember[]
  createdTasks       Task[]          @relation("TaskCreatedBy")
  assignedTasks      Task[]          @relation("TaskAssignee")
  comments           Comment[]
  issuesReported     Issue[]         @relation("IssueReportedBy")
  issuesAssigned     Issue[]         @relation("IssueAssignedTo")
  attachments        Attachment[]    @relation("AttachmentUploadedBy")

  @@index([roleId])
  @@index([departmentId])
  @@map("staffs")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  staffs Staff[]

  @@map("roles")
}

model Department {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  staffs Staff[]

  @@map("departments")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  statusId String        @map("status_id") @db.Uuid
  status   ProjectStatus @relation(fields: [statusId], references: [id], onDelete: NoAction)

  projectMembers ProjectMember[]
  phases         Phase[]
  milestones     Milestone[]
  tasks          Task[]
  attachments    Attachment[]

  @@index([statusId])
  @@map("projects")
}

model ProjectStatus {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  projects Project[]

  @@map("project_statuses")
}

model ProjectMember {
  id        String    @id @default(uuid()) @db.Uuid
  joinedAt  DateTime  @map("joined_at") @db.Date
  leftAt    DateTime? @map("left_at") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  memberId     String     @map("member_id") @db.Uuid
  member       Staff      @relation(fields: [memberId], references: [id], onDelete: NoAction)
  projectId    String     @map("project_id") @db.Uuid
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberRoleId String     @map("member_role_id") @db.Uuid
  memberRole   MemberRole @relation(fields: [memberRoleId], references: [id], onDelete: NoAction)

  @@unique([projectId, memberId])
  @@index([memberId])
  @@index([projectId])
  @@index([memberRoleId])
  @@map("project_members")
}

model MemberRole {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  projectMembers ProjectMember[]

  @@map("member_roles")
}

model Task {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  description     String?
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  plannedHours    Decimal?  @map("planned_hours") @db.Decimal(10, 2)
  actualHours     Decimal?  @map("actual_hours") @db.Decimal(10, 2)
  progressPercent Int       @default(0) @map("progress_percent")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  createdById  String       @map("created_by") @db.Uuid
  createdBy    Staff        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  assigneeId   String?      @map("assignee_id") @db.Uuid
  assignee     Staff?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentTaskId String?      @map("parent_task_id") @db.Uuid
  parentTask   Task?        @relation("TaskParent", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks   Task[]       @relation("TaskParent")
  statusId     String       @map("status_id") @db.Uuid
  status       TaskStatus   @relation(fields: [statusId], references: [id], onDelete: NoAction)
  priorityId   String       @map("priority_id") @db.Uuid
  priority     TaskPriority @relation(fields: [priorityId], references: [id], onDelete: NoAction)
  projectId    String       @map("project_id") @db.Uuid
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId      String?      @map("phase_id") @db.Uuid
  phase        Phase?       @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestoneId  String?      @map("milestone_id") @db.Uuid
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  comments                Comment[]
  issues                  Issue[]
  attachments             Attachment[]
  predecessorDependencies TaskDependency[] @relation("TaskDependencyPredecessor")
  successorDependencies   TaskDependency[] @relation("TaskDependencySuccessor")

  @@index([createdById])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([statusId])
  @@index([priorityId])
  @@index([projectId])
  @@index([phaseId])
  @@index([milestoneId])
  @@map("tasks")
}

model TaskStatus {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tasks Task[]

  @@map("task_statuses")
}

model TaskPriority {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tasks Task[]

  @@map("task_priorities")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  taskId  String @map("task_id") @db.Uuid
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffId String @map("staff_id") @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: NoAction)

  @@index([taskId])
  @@index([staffId])
  @@map("comments")
}

model Issue {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(100)
  description String?
  dueDate     DateTime? @map("due_date") @db.Date
  resolvedAt  DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  reportedById String @map("reported_by") @db.Uuid
  reportedBy   Staff  @relation("IssueReportedBy", fields: [reportedById], references: [id], onDelete: NoAction)
  assigneeId   String @map("assignee_id") @db.Uuid
  assignee     Staff  @relation("IssueAssignedTo", fields: [assigneeId], references: [id], onDelete: NoAction)
  taskId       String @map("task_id") @db.Uuid
  task         Task   @relation(fields: [taskId], references: [id], onDelete: NoAction)

  @@index([reportedById])
  @@index([assigneeId])
  @@index([taskId])
  @@map("issues")
}

model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(255)
  fileSize  BigInt?  @map("file_size")
  mimeType  String?  @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  uploadedById String?  @map("uploaded_by") @db.Uuid
  uploadedBy   Staff?   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  taskId       String?  @map("task_id") @db.Uuid
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId    String?  @map("project_id") @db.Uuid
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@index([taskId])
  @@index([projectId])
  @@map("attachments")
}

enum TaskDependencyType {
  FS
  SS
  FF
  SF
}

model TaskDependency {
  id             String             @id @default(uuid()) @db.Uuid
  dependencyType TaskDependencyType @map("dependency_type")
  lagDays        Int                @default(0) @map("lag_days")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")

  predecessorTaskId String @map("predecessor_task_id") @db.Uuid
  predecessorTask   Task   @relation("TaskDependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTaskId   String @map("successor_task_id") @db.Uuid
  successorTask     Task   @relation("TaskDependencySuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([successorTaskId])
  @@map("task_dependencies")
}

model Phase {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  projectId String      @map("project_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusId  String      @map("status_id") @db.Uuid
  status    PhaseStatus @relation(fields: [statusId], references: [id], onDelete: NoAction)

  tasks      Task[]
  milestones Milestone[]

  @@index([projectId])
  @@index([statusId])
  @@map("phases")
}

model PhaseStatus {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  phases Phase[]

  @@map("phase_statuses")
}

model Milestone {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  description   String?
  dueDate       DateTime  @map("due_date") @db.Date
  completedDate DateTime? @map("completed_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  projectId String          @map("project_id") @db.Uuid
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   String?         @map("phase_id") @db.Uuid
  phase     Phase?          @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  statusId  String          @map("status_id") @db.Uuid
  status    MilestoneStatus @relation(fields: [statusId], references: [id], onDelete: NoAction)

  tasks Task[]

  @@index([projectId])
  @@index([phaseId])
  @@index([statusId])
  @@map("milestones")
}

model MilestoneStatus {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  milestones Milestone[]

  @@map("milestone_statuses")
}
