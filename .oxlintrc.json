{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "unicorn",
        "import"
    ],
    "rules": {
        "no-unused-vars": "warn",
        "typescript/no-explicit-any": "warn"
    },
    "ignorePatterns": [
        "dist",
        "node_modules"
    ]
}